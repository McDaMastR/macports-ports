PortSystem              1.0
PortGroup               github 1.0
PortGroup               gradle 1.0

name                    hamcrest
github.setup            hamcrest JavaHamcrest 3.0 v
github.tarball_from     archive
github.livecheck.regex  {([0-9.]+)}

categories              java devel
license                 BSD
platforms               any
supported_archs         noarch
homepage                https://hamcrest.org
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             Flexible matching logic framework
long_description        Hamcrest is a Java framework for writing matcher \
                        objects and corresponding 'match' rules.  The \
                        framework is flexible and fit for use with UI \
                        validation, data filtering, and unit testing.

gradle.major            8

java.version            1.8+

checksums               rmd160  a49c7c2697c608f2dec3a7518e0751497c02bf06 \
                        sha256  75f7a70e99b84ebfa21ed8003fd44df9920ec20b88015c5f3a388bceddc9907f \
                        size    880513

destroot {
    set destdocdir  ${destroot}/${prefix}/share/doc/${name}
    set destjavadir ${destroot}/${prefix}/share/java

    xinstall -d ${destjavadir}
    xinstall -W ${worksrcpath} -m 644 \
        ${name}/build/libs/${name}-${version}.jar \
        ${destjavadir}/${name}.jar

    xinstall -d ${destdocdir}
    xinstall -W ${worksrcpath} -m 644 \
        CHANGES.md \
        LICENSE \
        README.md \
        RELEASING.md \
        ${destdocdir}

    if {[variant_isset doc]} {
        copy ${worksrcpath}/${name}/build/docs/javadoc ${destdocdir}
    }
}

variant doc \
        description {Install javadoc} {
    gradle.build_tasks-append   javadoc
}
