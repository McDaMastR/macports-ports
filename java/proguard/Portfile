PortSystem              1.0
PortGroup               github 1.0
PortGroup               gradle 1.0

github.setup            Guardsquare proguard 7.10.0 v
github.tarball_from     archive
revision                0

categories              java
license                 GPL-2+
platforms               any
supported_archs         noarch
homepage                https://www.guardsquare.com/proguard
maintainers             {sethm.id.au:dev @McDaMastR} \
                        openmaintainer

description             Java bytecode shrinker, optimizer, and obfuscator.
long_description        ProGuard detects and removes unused classes, fields, \
                        methods, and attributes from Java bytecode.  It \
                        optimizes the bytecode and removes unused \
                        instructions.  It renames the remaining classes, \
                        fields, and methods using short meaningless names. \
                        And it preverifies the processed code for Java 6+ and \
                        Java Micro Edition.

# Building requires Java >= 11
# Running requires Java >= 8
gradle.major            8
java.version            11+

checksums               rmd160  508d91fa00b028c38790f657fabbc1ac83bc6bc0 \
                        sha256  6a1b2b1130af3755e6d1b8baecc9cd9c78f23b30425c591cddcf36634bc134da \
                        size    1243180

# Tests fail and complain about a "Debug metadata version mismatch".
# Possibly related to <https://github.com/gradle/gradle/issues/34453>.
# Disable tests for now; check if they pass on next update.
test.run                no

destroot {
    set destdocdir  ${destroot}${prefix}/share/doc/${name}
    set destjavadir ${destroot}${prefix}/share/java/${name}

    xinstall -d ${destjavadir}
    xinstall -W ${worksrcpath} -m 644 \
        lib/${name}.jar \
        lib/${name}-ant.jar \
        lib/${name}gui.jar \
        lib/retrace.jar \
        ${destjavadir}

    xinstall -d ${destdocdir}
    xinstall -W ${worksrcpath} -m 644 \
        CONTRIBUTING.md \
        LICENSE \
        README.md \
        ${destdocdir}
    copy {*}[glob -directory ${worksrcpath}/docs/md *] ${destdocdir}

    if {[variant_isset doc]} {
        xinstall -d ${destdocdir}/javadoc
        foreach module {annotations ant base gradle-plugin gui retrace} {
            copy -W ${worksrcpath} \
                ${module}/build/docs/javadoc \
                ${destdocdir}/javadoc/${module}
        }
    }
}

variant doc \
        description {Install javadoc} {
    gradle.build_tasks-append   javadoc
}
